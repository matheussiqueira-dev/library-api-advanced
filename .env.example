# Copy to .env for local development. Never commit .env.
# Every value below is a safe default or a placeholder.

# --- App metadata
PROJECT_NAME="Library API Advanced"
PROJECT_DESCRIPTION="A senior-grade, async-first Library API with a modern UX."
VERSION=1.1.0
API_V1_STR=/api/v1

# --- Database
# Local default is a SQLite file. Production needs a real database URL.
DATABASE_URL=sqlite+aiosqlite:///./library.db
# Creates tables on startup. Keep false where migrations manage the schema.
DB_AUTO_CREATE=true

# --- Observability
LOG_LEVEL=INFO

# --- Public write protection
# Kill switch: false makes POST/PUT/DELETE return 503.
WRITES_ENABLED=true
# Maximum number of books; creating beyond it returns 409.
DEMO_MAX_BOOKS=500
# Request bodies above this size return 413.
MAX_REQUEST_BODY_BYTES=16384
# Per-IP sliding window, per app instance. Over the limit returns 429.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WRITES_PER_WINDOW=20
RATE_LIMIT_LOOKUPS_PER_WINDOW=10
# Use the first X-Forwarded-For address as the client IP.
# Only set true behind a proxy that overwrites that header (e.g. Vercel).
TRUST_PROXY_HEADERS=false
